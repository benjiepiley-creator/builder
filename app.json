{
  "expo": {
    "name": "RiskRadar",
    "slug": "riskradar",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#060912"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.riskradar.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "RiskRadar lets you choose listing screenshots and item photos for AI-assisted purchase risk analysis.",
        "NSCameraUsageDescription": "RiskRadar can use the camera to capture item photos for purchase risk analysis."
      }
    },
    "android": {
      "package": "com.riskradar.app",
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-image-picker"
    ]
  }
}
